# Nearest Forest — static PWA on Apache shared hosting.

# Apache does not know .webmanifest by default; without this iOS ignores the manifest.
AddType application/manifest+json .webmanifest
AddType image/png .png

# The service worker must be served fresh, or a stale one pins an old app version forever.
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# The dataset is versioned by the service worker cache name, so let the browser cache it.
<FilesMatch "\.(png|css|js|json|webmanifest)$">
  Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# Geolocation needs HTTPS. Force it, since the app silently loses GPS on plain HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
