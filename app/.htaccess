# Nearest Forest — static PWA on Apache shared hosting.

# Apache does not know .webmanifest by default; without this iOS ignores the manifest.
AddType application/manifest+json .webmanifest
AddType image/png .png

# The service worker must be served fresh, or a stale one pins an old app version forever.
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Code and data are versioned by the service worker cache name, so HTTP caching
# them buys nothing and actively breaks updates: the service worker's own
# precache fetches go through this cache, so a max-age here can pin an installed
# copy to old bytes under a fresh cache name. no-cache still allows a cheap
# 304 via ETag; it only forbids using a stale copy without asking.
<FilesMatch "\.(html|css|js|json|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Images are content-addressed by name and effectively never change.
<FilesMatch "\.(png|ico)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# Geolocation needs HTTPS. Force it, since the app silently loses GPS on plain HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
